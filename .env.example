# Cloudinary (Upload signé & livraison privée authenticated)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (Envoi d'emails transactionnels)
RESEND_API_KEY=""
